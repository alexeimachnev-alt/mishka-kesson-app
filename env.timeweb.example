# Скопируй на сервер как .env (рядом с docker-compose.yml)

IOS_API_ONLY=1
DISABLE_KEEPALIVE=1
PORT=8080

ALEXEI_ICLOUD_PASSWORD=твой-пароль-входа-ios
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ПК МИШКА

# Доставка: маршруты и геокодирование (ключи не в iOS — только на сервере)
# YANDEX_GEOCODER_API_KEY=
# YANDEX_ROUTING_API_KEY=
# Или один ключ для обоих:
# YANDEX_MAPS_API_KEY=
# MISHKA_WAREHOUSE_LAT=56.047416
# MISHKA_WAREHOUSE_LON=37.538633

# Если позже нужен Telegram на этом же сервере — IOS_API_ONLY=0 и токен:
# TELEGRAM_BOT_TOKEN=
# ADMIN_CHAT_ID=551209811
# RENDER_EXTERNAL_URL=https://api.твой-домен.ru